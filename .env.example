# Racontez-moi.com — variables d'environnement nécessaires.
# Copier en .env.local (déjà ignoré par git, cf. .gitignore) et remplir.
# Aucune valeur réelle ici — uniquement les noms attendus par le code
# (vérifié par recherche exhaustive de `process.env.*` dans le dépôt,
# Phase 7 de l'audit sécurité, 12/09/2026).

# ── Supabase ─────────────────────────────────────────────────────────────
# EN LOCAL : toujours pointer vers un projet Supabase de TEST dédié,
# JAMAIS vers le projet de production — voir docs/security/SECURITY.md
# (section "Séparation des environnements") avant de remplir ces valeurs.
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET-TEST.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Utilisée uniquement par scripts/seed-banque-questions.ts et
# scripts/ingest-livres-reference.ts (ingestion hors requête utilisateur) —
# même projet que NEXT_PUBLIC_SUPABASE_URL ci-dessus.
SUPABASE_URL=https://VOTRE-PROJET-TEST.supabase.co
# Contourne RLS entièrement — la variable la plus sensible de ce fichier.
SUPABASE_SERVICE_ROLE_KEY=

# Marqueur explicite consommé par le garde-fou anti-production
# (scripts/garde-environnement-test.ts) avant tout test destructif —
# doit valoir exactement "test", jamais renseigné en production.
SUPABASE_ENV=test

# ── IA ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
HF_API_KEY=

# ── Email transactionnel ────────────────────────────────────────────────
BREVO_API_KEY=

# ── Impression (Lulu) — sandbox par défaut, cf. lib/lulu.ts ────────────
LULU_SANDBOX_CLIENT_KEY=
LULU_SANDBOX_CLIENT_SECRET=
LULU_PRODUCTION=false
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=

# ── Paiement (Stripe) — toujours des clés sk_test_/whsec_ en local ─────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PARCOURS=

# ── Suivi d'erreurs (Sentry) ────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
